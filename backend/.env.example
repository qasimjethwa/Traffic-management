# Backend configuration (all optional except the database URL). Never commit a real .env.
MF_DATABASE_URL=postgresql+psycopg://mumbai_flow:mumbai_flow@localhost:5432/mumbai_flow
MF_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# OSRM: public demo server by default (light, non-production use). Point to your own instance for production.
# MF_OSRM_URL=https://router.project-osrm.org

# Google Routes API — enables on-demand traffic-aware estimates (text only; never stored/mapped/used for ML).
# Billed per request by Google; keep the caps low.
# MF_GOOGLE_MAPS_API_KEY=
# MF_GOOGLE_ROUTES_DAILY_CAP=90
# MF_GOOGLE_ROUTES_PER_MINUTE_CAP=6

# Open-Meteo: free tier is non-commercial; commercial plans need a key.
# MF_OPEN_METEO_API_KEY=
