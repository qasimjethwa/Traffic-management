# Copy to .env.local for local development. All values are optional and public
# (they end up in the browser bundle) — never put private secrets here.

# Base path for the build. The GitHub Actions workflow sets this automatically to /<repo>/.
# VITE_BASE_PATH=/mumbai-flow/

# Optional: Stadia Maps key. When set, the "Dark" basemap uses Stadia "Alidade Smooth Dark"
# instead of the keyless Esri Dark Gray Canvas. Restrict the key to your Pages domain.
# VITE_STADIA_API_KEY=

# Optional: your own OSRM server. Defaults to the public OSRM demo server
# (https://router.project-osrm.org), which is for light, non-production use only.
# VITE_OSRM_URL=https://router.project-osrm.org
